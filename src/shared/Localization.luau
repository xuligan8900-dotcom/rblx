	return if locale and string.lower(string.sub(locale, 1, 2)) == "ru" then "ru" else "en"
end
function L.text(language: string, key: string, ...: any): string
	local dictionary = if language == "ru" then L.ru else L.en
	local value = dictionary[key] or L.en[key] or key
	if select("#", ...) > 0 then
		return string.format(value, ...)
	end
	return value
end
return L
