      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Genetics</string>
          <string name="Source"><![CDATA[--!strict
local G = {}
G.genes = { "color", "size", "speed", "yield", "resistance", "affinity", "light", "stability" }
export type Genome = { [string]: { number } }
function G.create(random: () -> number): Genome
	local genome = {}
	for _, key in G.genes do
		genome[key] = { math.floor(random() * 4), math.floor(random() * 4) }
	end
	return genome
end
function G.phenotype(genome: Genome): { [string]: number }
	local result = {}
	for _, key in G.genes do
		local pair = genome[key]
		-- Allele 3 dominates; other combinations express their mean.
		result[key] = if pair[1] == 3 or pair[2] == 3 then 3 else (pair[1] + pair[2]) / 2
	end
	return result
end
function G.cross(a: Genome, b: Genome, random: () -> number): Genome
	local result = {}
	for _, key in G.genes do
		local pair = { a[key][if random() < 0.5 then 1 else 2], b[key][if random() < 0.5 then 1 else 2] }
		if random() < 0.025 then
			pair[if random() < 0.5 then 1 else 2] = math.floor(random() * 4)
		end
		result[key] = pair
	end
	return result
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Interaction</string>
          <string name="Source"><![CDATA[--!strict
-- Presentation decisions only. The server independently validates every action.
local Interaction = {}
function Interaction.resolve(profile: any, cell: number, seed: string, now: number): (string?, any, string)
	for id, plant in profile.plants do
		if plant.cell == cell then
			if plant.progress >= 1 then
				return "Harvest", { id = id }, "harvest"
			end
			if plant.waterUntil > now then
				return nil, {}, "growing_hint"
			end
			return "Water", { id = id }, "water"
		end
	end
	if (profile.seeds[seed] or 0) < 1 then
		return nil, {}, "error_no_seed"
	end
	return "Plant", { id = seed, cell = cell }, "plant"
end
function Interaction.mission(profile: any): string
	local stats = profile.stats or {}
	if (stats.planted or 0) == 0 then
		return "mission_plant"
	end
	if (stats.watered or 0) == 0 then
		return "mission_water"
	end
	if (stats.harvested or 0) == 0 then
		return "mission_harvest"
	end
	if (stats.sold or 0) == 0 then
		return "mission_sell"
	end
	return "mission_experiment"
end
return Interaction
]]></string>
        </Properties>
      </Item>
