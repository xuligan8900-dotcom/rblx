      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Protocol</string>
          <string name="Source"><![CDATA[--!strict
local Protocol = {}
local fields: { [string]: { string } } = {
	Buy = { "id" },
	Plant = { "id", "cell" },
	Water = { "id" },
	Replant = { "id", "cell" },
	Harvest = { "id" },
	Sell = { "id" },
	Favorite = { "id" },
	Cross = { "id", "other" },
	Research = { "id" },
	Expand = {},
	Quest = {},
	Sync = {},
	Home = {},
}
function Protocol.valid(action: any, args: any): boolean
	if type(action) ~= "string" or type(args) ~= "table" then
		return false
	end
	local allowed = fields[action]
	if not allowed then
		return false
	end
	local seen = 0
	for k, v in args do
		seen += 1
		if seen > 2 or type(k) ~= "string" or not table.find(allowed, k) then
			return false
		end
		if k == "cell" then
			if type(v) ~= "number" or v ~= v or v % 1 ~= 0 or v < 1 or v > 96 then
				return false
			end
		elseif type(v) ~= "string" or #v < 1 or #v > 64 then
			return false
		end
	end
	for _, k in allowed do
		if args[k] == nil then
			return false
		end
	end
	return true
end
return Protocol
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Simulation</string>
          <string name="Source"><![CDATA[--!nocheck
-- Pure authoritative state transitions. No yields, network, instances or client time.
local S = {}
function S.new(catalog, genetics, random, uuid)
	local api = {}
	local species = {}
	for _, c in catalog.plants do
		species[c.id] = c
	end
	local function count(t)
		local n = 0
		for _ in t do
			n += 1
		end
		return n
	end
	function api.profile()
		return {
			version = 1,
			coins = 100,
			rp = 0,
			xp = 0,
			seeds = { p01 = 6, p02 = 4 },
			plants = {},
			harvest = {},
			research = {},
			collection = {},
			quest = 0,
			questClaim = 0,
			expansion = 1,
			lastExperiment = 0,
			tutorial = 1,
			settings = { language = "en", effects = true },
			savedAt = 0,
		}
	end
	function api.validate(p)
		if type(p) ~= "table" or p.version ~= 1 then
			return false
		end
		for _, k in { "coins", "rp", "xp", "quest", "questClaim", "expansion", "lastExperiment", "tutorial", "savedAt" } do
			if type(p[k]) ~= "number" or p[k] ~= p[k] or p[k] < 0 or p[k] == math.huge then
				return false
			end
		end
		if p.expansion % 1 ~= 0 or p.expansion < 1 or p.expansion > 5 then
			return false
		end
		for _, k in { "seeds", "plants", "harvest", "research", "collection", "settings" } do
			if type(p[k]) ~= "table" then
				return false
			end
		end
		for id, n in p.seeds do
			if not species[id] or type(n) ~= "number" or n < 0 or n % 1 ~= 0 or n > 10000 then
				return false
			end
		end
		for _, group in { p.plants, p.harvest } do
			if count(group) > catalog.inventoryCap then
				return false
			end
			for id, plant in group do
				if
					type(id) ~= "string"
					or type(plant) ~= "table"
					or not species[plant.species]
					or type(plant.genome) ~= "table"
				then
					return false
				end
				for _, g in genetics.genes do
					local pair = plant.genome[g]
					if type(pair) ~= "table" then
						return false
					end
					for i = 1, 2 do
						local v = pair[i]
						if type(v) ~= "number" or v % 1 ~= 0 or v < 0 or v > 3 then
							return false
						end
					end
				end
				for _, k in { "progress", "updated", "waterUntil", "cell", "seed" } do
					local v = plant[k]
					if type(v) ~= "number" or v ~= v or v < 0 or v == math.huge then
						return false
					end
				end
				if plant.id ~= id or plant.progress > 1 or plant.cell % 1 ~= 0 or plant.cell > 96 then
					return false
				end
				if
					group == p.harvest
					and (
						type(plant.amount) ~= "number"
						or plant.amount % 1 ~= 0
						or plant.amount < 1
						or plant.amount > 100
					)
				then
					return false
				end
				if type(plant.mutations) ~= "table" then
					return false
				end
				local seen = {}
				for _, m in plant.mutations do
					local known = false
					for _, cfg in catalog.mutations do
						if cfg.id == m then
							known = true
						end
					end
					if not known or seen[m] then
						return false
					end
					seen[m] = true
				end
				if #plant.mutations > 3 or (seen.Giant and seen.Miniature) then
					return false
				end
			end
		end
		local cells = {}
		for _, plant in p.plants do
			if plant.cell < 1 or plant.cell > catalog.expansions[p.expansion] or cells[plant.cell] then
				return false
			end
			cells[plant.cell] = true
		end
		return true
	end
	function api.level(p)
		return 1 + math.floor(p.xp / 50)
	end
	function api.biome(p)
		local n = 1
		for i = 1, 5 do
			if p.research["Botany" .. i] then
				n = i + 1
			end
		end
		return n
	end
	function api.advance(p, now, offline)
		for _, plant in p.plants do
			local c = species[plant.species]
			local ph = genetics.phenotype(plant.genome)
			local dt = math.max(0, now - plant.updated)
			if offline then
				dt = math.min(dt, catalog.offlineCap)
			end
			local wet = math.clamp(plant.waterUntil - plant.updated, 0, dt)
			-- Each automation tier improves a specific part of unattended care.
			if p.research.Automation1 then
				wet = dt * 0.25
			end
			if p.research.Automation2 then
				wet = dt * 0.5
			end
			if p.research.Automation3 then
				wet = dt * 0.75
			end
			if p.research.Automation4 then
				wet = dt
			end
			local bonus = 0
			for i = 1, 6 do
				if p.research["Cultivation" .. i] then
					bonus += 0.06
				end
			end
			local speed = 1
				+ ph.speed * 0.1
				+ bonus
				+ (if p.research.Automation5 then 0.1 else 0)
				+ (if p.research.Automation6 then 0.15 else 0)
			for _, m in plant.mutations do
				for _, cfg in catalog.mutations do
					if cfg.id == m then
						speed *= cfg.growth
					end
				end
			end
			plant.progress = math.min(1, plant.progress + (dt + wet * 0.4) * speed / c.seconds)
			plant.updated = math.max(plant.updated, now)
		end
	end
	function api.price(plant)
		local bonus = 1
		for _, m in plant.mutations do
			for _, cfg in catalog.mutations do
				if cfg.id == m then
					bonus += cfg.value
				end
			end
		end
		local c = species[plant.species]
		local ph = genetics.phenotype(plant.genome)
		return math.floor(c.value * plant.amount * math.min(4, bonus) * (1 + ph.size * 0.05))
	end
	function api.probability(m, plant, p, weather)
		if m.biome ~= 0 and m.biome ~= species[plant.species].biome then
			return 0
		end
		local ph = genetics.phenotype(plant.genome)
		local research = 1
		for i = 1, 6 do
			if p.research["Genetics" .. i] then
				research += 0.15
			end
		end
		return math.clamp(
			m.probability
				* (1 + ph.affinity * 0.1)
				* (1 - ph.resistance * 0.08)
				* (if weather == "Aurora" then 1.5 else 1)
				* research,
			0,
			0.15
		)
	end
	function api.act(p, action, args, now, weather)
		api.advance(p, now, false)
		if action == "Buy" then
			local c = species[args.id]
			if not c or c.biome > api.biome(p) or c.level > api.level(p) then
				return false, "Species locked"
			end
			if p.coins < c.price or (p.seeds[c.id] or 0) >= 10000 then
				return false, "Not enough coins or stack full"
			end
			p.coins -= c.price
			p.seeds[c.id] = (p.seeds[c.id] or 0) + 1
		elseif action == "Plant" then
			local c = species[args.id]
			local cell = args.cell
			if
				not c
				or type(cell) ~= "number"
				or cell % 1 ~= 0
				or cell < 1
				or cell > catalog.expansions[p.expansion]
				or c.biome > api.biome(p)
			then
				return false, "Invalid planting"
			end
			if (p.seeds[c.id] or 0) < 1 then
				return false, "No seed"
			end
			for _, v in p.plants do
				if v.cell == cell then
					return false, "Cell occupied"
				end
			end
			local id = uuid()
			p.seeds[c.id] -= 1
			p.plants[id] = {
				id = id,
				species = c.id,
				cell = cell,
				genome = genetics.create(random),
				mutations = {},
				seed = math.floor(random() * 1000000),
				progress = 0,
				updated = now,
				waterUntil = 0,
			}
			p.tutorial = math.max(p.tutorial, 2)
		elseif action == "Replant" then
			local plant = p.harvest[args.id]
			local cell = args.cell
			if
				not plant
				or plant.favorite
				or type(cell) ~= "number"
				or cell % 1 ~= 0
				or cell < 1
				or cell > catalog.expansions[p.expansion]
			then
				return false, "Invalid specimen or cell"
			end
			for _, v in p.plants do
				if v.cell == cell then
					return false, "Cell occupied"
				end
			end
			p.harvest[args.id] = nil
			p.plants[args.id] = plant
			plant.cell = cell
			plant.progress = 0
			plant.updated = math.max(plant.updated, now)
			plant.waterUntil = 0
			plant.amount = nil
		elseif action == "Water" then
			local plant = p.plants[args.id]
			if not plant then
				return false, "Plant not found"
			end
			plant.waterUntil = now + 120
			p.tutorial = math.max(p.tutorial, 3)
		elseif action == "Harvest" then
			local plant = p.plants[args.id]
			if not plant or plant.progress < 1 or count(p.harvest) >= catalog.inventoryCap then
				return false, "Not ready or inventory full"
			end
			local selected = table.clone(plant.mutations)
			local total = 0
			for _, m in catalog.mutations do
				total += api.probability(m, plant, p, weather)
			end
			local roll = random() * math.max(1, total)
			for _, m in catalog.mutations do
				roll -= api.probability(m, plant, p, weather)
				if roll < 0 then
					if
						#selected < 3
						and not table.find(selected, m.id)
						and not (
							(m.id == "Giant" and table.find(selected, "Miniature"))
							or (m.id == "Miniature" and table.find(selected, "Giant"))
						)
					then
						table.insert(selected, m.id)
					end
					break
				end
			end
			plant.mutations = selected
			plant.amount = species[plant.species].yieldCount
				+ math.floor(genetics.phenotype(plant.genome)["yield"] * 0.5)
			if table.find(selected, "Giant") then
				plant.amount += 2
			end
			p.plants[args.id] = nil
			p.harvest[args.id] = plant
			p.xp += 10
			p.quest += 1
			if not p.collection[plant.species] then
				p.collection[plant.species] = true
				p.rp += (if p.research.Botany6 then 8 else 5)
			end
			p.rp += 1
			p.tutorial = math.max(p.tutorial, 4)
		elseif action == "Sell" then
			local plant = p.harvest[args.id]
			if not plant or plant.favorite then
				return false, "Plant missing or protected"
			end
			local bonus = 0
			for i = 1, 6 do
				if p.research["Economy" .. i] then
					bonus += 0.04
				end
			end
			p.coins = math.min(1e9, p.coins + math.floor(api.price(plant) * (1 + bonus)))
			p.harvest[args.id] = nil
			p.tutorial = math.max(p.tutorial, 5)
		elseif action == "Favorite" then
			local plant = p.harvest[args.id]
			if not plant then
				return false, "Plant not found"
			end
			plant.favorite = not plant.favorite
		elseif action == "Cross" then
			local a, b = p.harvest[args.id], p.harvest[args.other]
			if not a or not b or a == b or a.favorite or b.favorite or p.coins < 30 or now - p.lastExperiment < 15 then
				return false, "Two unprotected parents, 30 coins and cooldown required"
			end
			if species[a.species].archetype ~= species[b.species].archetype then
				return false, "Parents need matching architecture"
			end
			local id = uuid()
			local child = {
				id = id,
				species = if random() < 0.5 then a.species else b.species,
				genome = genetics.cross(a.genome, b.genome, random),
				mutations = {},
				seed = math.floor(random() * 1000000),
				progress = 1,
				updated = now,
				waterUntil = 0,
				cell = 0,
				amount = 1,
			}
			p.harvest[a.id] = nil
			p.harvest[b.id] = nil
			p.harvest[id] = child
			p.coins -= 30
			p.rp += 3
			p.lastExperiment = now
			p.tutorial = 6
		elseif action == "Research" then
			local cfg = nil
			for _, r in catalog.research do
				if r.id == args.id then
					cfg = r
				end
			end
			if
				not cfg
				or p.research[cfg.id]
				or p.rp < cfg.cost
				or (cfg.requires ~= "" and not p.research[cfg.requires])
			then
				return false, "Research prerequisites missing"
			end
			p.rp -= cfg.cost
			p.research[cfg.id] = true
		elseif action == "Expand" then
			local cost = p.expansion * 250
			if p.expansion >= 5 or p.coins < cost then
				return false, "Expansion unavailable"
			end
			p.coins -= cost
			p.expansion += 1
		elseif action == "Quest" then
			local goal = (p.questClaim + 1) * 5
			if p.quest < goal then
				return false, "Harvest " .. goal .. " plants first"
			end
			p.questClaim += 1
			p.coins += 75
			p.rp += 5
		else
			return false, "Unknown action"
		end
		return true, "Done"
	end
	return api
end
return S
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Garden</string>
      </Properties>
      <Item class="Script" referent="10">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nocheck
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Shared = RS:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Genetics = require(Shared.Genetics)
local Protocol = require(Shared.Protocol)
local rng = Random.new()
local sim = require(Shared.Simulation).new(Catalog, Genetics, function()
	return rng:NextNumber()
end, function()
	return HttpService:GenerateGUID(false)
end)
local profiles = require(script.Parent.Profiles).new(sim)
local world = require(script.Parent.World).new(Catalog)
local remote = Instance.new("RemoteFunction")
remote.Name = "GardenRequest"
remote.Parent = RS
local slots = {}
local rates = {}
local safe = {}
local closing = false
local weather = "Sunny"
local weatherUntil = os.time() + 300
local function teleport(player, character)
	local slot = slots[player]
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root and slot then
		local center = world.plots[slot].center
		character:PivotTo(CFrame.lookAt(center + Vector3.new(0, 5, 18), center + Vector3.new(-10, 3, -12)))
	end
end
local function join(player)
	if closing then
		player:Kick("Server closing. Please reconnect.")
		return
	end
	local p = profiles:load(player)
	if not p then
		player:Kick(
			"Your garden could not be loaded safely. Enable Studio API access for testing, or try again shortly."
		)
		return
	end
	if player.Parent ~= Players then
		profiles:save(player, true)
		return
	end
	local slot = world:claim(player)
	if not slot then
		profiles:save(player, true)
		player:Kick("All eight gardens are occupied.")
		return
	end
	slots[player] = slot
	safe[player] = true
	player.CharacterAdded:Connect(function(c)
		teleport(player, c)
	end)
	if player.Character then
		task.spawn(teleport, player, player.Character)
	end
	world:render(slot, p, sim, Genetics)
end
local function leave(player)
	safe[player] = nil
	-- Wait for an in-flight autosave before final save; only our own bounded operation.
	local deadline = os.clock() + 20
	while profiles.busy[player] and os.clock() < deadline do
		task.wait(0.1)
	end
	local saved = false
	for _ = 1, 3 do
		if profiles:save(player, true) then
			saved = true
			break
		end
		task.wait(1)
	end
	if not saved then
		warn("Garden save failed; session lease will expire", player.UserId)
	end
	if slots[player] then
		world:release(slots[player])
		slots[player] = nil
	end
	profiles.loaded[player] = nil
	rates[player] = nil
end
remote.OnServerInvoke = function(player, action, args)
	local t = os.clock()
	local rate = rates[player] or { tokens = 12, time = t }
	rates[player] = rate
	rate.tokens = math.min(12, rate.tokens + (t - rate.time) * 4)
	rate.time = t
	if rate.tokens < 1 then
		return { ok = false, message = "Please slow down" }
	end
	rate.tokens -= 1
	if not Protocol.valid(action, args) then
		return { ok = false, message = "Invalid request" }
	end
	local p = profiles.loaded[player]
	if closing or not p or not safe[player] or not slots[player] then
		return { ok = false, message = "Garden unavailable" }
	end
	local farming = action == "Plant" or action == "Replant" or action == "Water" or action == "Harvest"
	if farming then
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local cell = args.cell
		if not cell then
			local plant = p.plants[args.id]
			cell = plant and plant.cell
		end
		if not root or (cell and (root.Position - world:cell(world.plots[slots[player]], cell)).Magnitude > 25) then
			return { ok = false, message = "Walk closer to your garden bed" }
		end
	end
	local ok, message = true, "Ready"
	if action == "Home" then
		if player.Character then
			teleport(player, player.Character)
		end
	elseif action ~= "Sync" then
		local success, a, b = pcall(sim.act, p, action, args, os.time(), weather)
		if not success then
			warn("Garden action failed", action, a)
			safe[player] = nil
			return { ok = false, message = "Garden paused for safety. Reconnect." }
		end
		ok, message = a, b
	else
		sim.advance(p, os.time(), false)
	end
	world:render(slots[player], p, sim, Genetics)
	return {
		ok = ok,
		message = message,
		profile = p,
		slot = slots[player],
		weather = weather,
		weatherUntil = weatherUntil,
		temporary = profiles.temporary,
	}
end
Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(leave)
for _, p in Players:GetPlayers() do
	task.spawn(join, p)
end
-- One scheduler per server; growth is analytical, models rebuild only on stage changes.
task.spawn(function()
	local nextSave = os.time() + 60
	while not closing do
		task.wait(2)
		local now = os.time()
		if now >= weatherUntil then
			weather = Catalog.weather[rng:NextInteger(1, #Catalog.weather)]
			weatherUntil = now + 300
		end
		for player, p in profiles.loaded do
			if slots[player] and safe[player] then
				sim.advance(p, now, false)
				if weather == "Rain" then
					for _, plant in p.plants do
						plant.waterUntil = now + 4
					end
				end
				world:render(slots[player], p, sim, Genetics)
				if now >= nextSave then
					task.spawn(function()
						if not profiles:save(player, false) then
							safe[player] = nil
							player:Kick("Saving unavailable. Reconnect shortly to protect your progress.")
						end
					end)
				end
			end
		end
		if now >= nextSave then
			nextSave = now + 60
		end
	end
end)
game:BindToClose(function()
	closing = true
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			leave(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 28
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Profiles</string>
          <string name="Source"><![CDATA[--!nocheck
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Profiles = {}
Profiles.__index = Profiles
function Profiles.new(sim)
	local temporary = game:GetService("RunService"):IsStudio() and game.GameId == 0
	local store = nil
	if temporary then
		warn("LOCAL STUDIO TEST: unpublished place; progress is temporary and resets when testing stops.")
	else
		store = DataStoreService:GetDataStore("MutationGarden_v1")
	end
	return setmetatable({
		store = store,
		temporary = temporary,
		sim = sim,
		loaded = {},
		token = game.JobId .. HttpService:GenerateGUID(false),
		busy = {},
	}, Profiles)
end
function Profiles:load(player)
	if self.temporary then
		local p = self.sim.profile()
		self.loaded[player] = p
		return p
	end
	local key = tostring(player.UserId)
	local now = os.time()
	local accepted = false
	local ok, record = pcall(function()
		return self.store:UpdateAsync(key, function(old)
			accepted = false
			if old and old.lock and old.lock.token ~= self.token and old.lock.expires > now then
				return nil
			end
			local data = if old then old.data else self.sim.profile()
			if not self.sim.validate(data) then
				return nil
			end
			accepted = true
			return { data = data, lock = { token = self.token, expires = now + 180 } }
		end)
	end)
	if not ok or not accepted or not record then
		return nil
	end
	local p = record.data
	self.sim.advance(p, now, true)
	self.loaded[player] = p
	return p
end
function Profiles:save(player, release)
	if self.temporary then
		if not self.loaded[player] then
			return false
		end
		if release then
			self.loaded[player] = nil
		end
		-- Successful temporary-state lifecycle, not a durable save.
		return true
	end
	if self.busy[player] then
		return false
	end
	local p = self.loaded[player]
	if not p then
		return false
	end
	self.busy[player] = true
	local snapshot = HttpService:JSONDecode(HttpService:JSONEncode(p))
	snapshot.savedAt = os.time()
	local wrote = false
	local ok = pcall(function()
		self.store:UpdateAsync(tostring(player.UserId), function(old)
			wrote = false
			if not old or not old.lock or old.lock.token ~= self.token then
				return nil
			end
			wrote = true
			return { data = snapshot, lock = if release then nil else { token = self.token, expires = os.time() + 180 } }
		end)
	end)
	self.busy[player] = nil
	if release and ok and wrote then
		self.loaded[player] = nil
	end
	return ok and wrote
end
return Profiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!nocheck
local World = {}
World.__index = World
local C = {
	grass = Color3.fromRGB(112, 137, 91),
	leaf = Color3.fromRGB(65, 98, 74),
	wood = Color3.fromRGB(117, 87, 65),
	cream = Color3.fromRGB(224, 211, 178),
	roof = Color3.fromRGB(48, 82, 73),
	soil = Color3.fromRGB(94, 65, 46),
}
local function part(parent, name, size, position, color, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.Position = position
	p.Color = color
	local wood = string.find(name, "[Tt]rim")
		or string.find(name, "[Ff]ence")
		or string.find(name, "[Ff]rame")
		or string.find(name, "[Cc]hest")
		or string.find(name, "[Bb]eam")
		or string.find(name, "[Ss]ign")
		or string.find(name, "[Cc]ounter")
	p.Material = if wood then Enum.Material.Wood else Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local function label(p, text)
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(160, 28)
	g.StudsOffset = Vector3.new(0, 2.5, 0)
	g.MaxDistance = 42
	g.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = C.roof
	t.BackgroundTransparency = 0.08
	t.Text = text
	t.TextColor3 = C.cream
	t.TextSize = 13
	t.Font = Enum.Font.GothamMedium
	t.Parent = g
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = t
end
local function beam(parent, a, b, width, color)
	local p = part(parent, "Beam", Vector3.new(width, width, (b - a).Magnitude), (a + b) / 2, color)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	return p
end
local function verticalCylinder(parent, name, radius, height, pos, color, material)
	local p = part(parent, name, Vector3.new(height, radius * 2, radius * 2), pos, color, Enum.PartType.Cylinder)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	p.Material = material or Enum.Material.SmoothPlastic
	return p
end
local function rock(parent, pos, size, tint)
	local p = Instance.new("WedgePart")
	p.Name = "Weathered stone"
	p.Anchored = true
	p.Size = size
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, (pos.X + pos.Z) * 0.23, 0.12)
	p.Color = tint or Color3.fromRGB(139, 144, 133)
	p.Material = Enum.Material.Slate
	p.Parent = parent
	return p
end
local function tree(parent, pos, scale, hue)
	local treeModel = Instance.new("Model")
	treeModel.Name = "Meadow tree"
	treeModel.Parent = parent
	local trunk = verticalCylinder(
		treeModel,
		"Bark trunk",
		0.55 * scale,
		8 * scale,
		pos + Vector3.new(0, 4, 0) * scale,
		C.wood,
		Enum.Material.Wood
	)
	for j = 1, 3 do
		local a = j * 2.399
		local endPoint = pos + Vector3.new(math.cos(a) * 3, 7 + j * 0.7, math.sin(a) * 3) * scale
		beam(treeModel, pos + Vector3.new(0, 4 + j * 0.4, 0) * scale, endPoint, 0.45 * scale, C.wood)
		local crown = part(
			treeModel,
			"Foliage cluster",
			Vector3.new(6.8, 4.6, 6.1) * scale,
			endPoint + Vector3.new(0, 1.5, 0) * scale,
			Color3.fromHSV(hue, 0.28, 0.42 + j * 0.045),
			Enum.PartType.Ball
		)
		crown.CFrame *= CFrame.Angles(j * 0.25, a, j * 0.13)
		crown.CanCollide = false
		local tip = part(
			treeModel,
			"Foliage highlight",
			Vector3.new(4.2, 2.8, 4) * scale,
			endPoint + Vector3.new(-1, 3, -0.5) * scale,
			Color3.fromHSV(hue, 0.26, 0.57 + j * 0.02),
			Enum.PartType.Ball
		)
		tip.CanCollide = false
	end
	-- Buttress roots visually anchor trees instead of floating balloon canopies.
	for j = 1, 3 do
		local a = j * math.pi * 2 / 3
		beam(
			treeModel,
			pos + Vector3.new(0, 0.6, 0) * scale,
			pos + Vector3.new(math.cos(a) * 1.7, 0.1, math.sin(a) * 1.7) * scale,
			0.5 * scale,
			C.wood
		)
	end
end
local function flower(parent, pos, color)
	local stem = part(parent, "Flower stem", Vector3.new(0.1, 0.85, 0.1), pos + Vector3.new(0, 0.42, 0), C.leaf)
	stem.CanCollide = false
	for j = 1, 4 do
		local a = j * math.pi / 2
		local petal = part(
			parent,
			"Silk petal",
			Vector3.new(0.48, 0.15, 0.7),
			pos + Vector3.new(math.cos(a) * 0.29, 0.9, math.sin(a) * 0.29),
			color,
			Enum.PartType.Ball
		)
		petal.CFrame *= CFrame.Angles(0, -a + 0.5, 0.12)
		petal.CanCollide = false
		petal.CanTouch = false
	end
	local center = part(
		parent,
		"Pollen center",
		Vector3.new(0.3, 0.2, 0.3),
		pos + Vector3.new(0, 0.97, 0),
		Color3.fromRGB(223, 181, 91),
		Enum.PartType.Ball
	)
	center.CanCollide = false
	local leaf = part(
		parent,
		"Flower leaf",
		Vector3.new(0.48, 0.1, 0.22),
		pos + Vector3.new(0.15, 0.35, 0),
		C.leaf,
		Enum.PartType.Ball
	)
	leaf.CFrame *= CFrame.Angles(0, 0, 0.4)
	leaf.CanCollide = false
end
local function lantern(parent, pos)
	local housing = part(parent, "Lantern frame", Vector3.new(0.75, 1.2, 0.75), pos, C.roof)
	local glass = part(parent, "Warm lantern", Vector3.new(0.65, 0.8, 0.79), pos, Color3.fromRGB(247, 208, 130))
	glass.Material = Enum.Material.Neon
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 218, 161)
	light.Brightness = 0.6
	light.Range = 10
	light.Shadows = false
	light.Parent = glass
	for _, y in { -0.6, 0.6 } do
		part(parent, "Lantern cap", Vector3.new(0.95, 0.15, 0.95), pos + Vector3.new(0, y, 0), C.roof)
	end
end
local function bench(parent, pos)
	for j = 1, 3 do
		part(parent, "Bench slat", Vector3.new(5, 0.18, 0.6), pos + Vector3.new(0, 1.5, (j - 2) * 0.68), C.wood)
	end
	for _, x in { -1.8, 1.8 } do
		part(parent, "Bench leg", Vector3.new(0.25, 1.6, 1.8), pos + Vector3.new(x, 0.8, 0), C.roof)
	end
	for j = 1, 2 do
		part(parent, "Bench back", Vector3.new(5, 0.5, 0.18), pos + Vector3.new(0, 2 + j * 0.6, -1), C.wood)
	end
end
local function fence(parent, origin, width)
	for x = -width / 2, width / 2, 6 do
		part(parent, "Fence post", Vector3.new(0.5, 3, 0.5), origin + Vector3.new(x, 1.5, 0), C.cream)
	end
	for _, y in { 1, 2.2 } do
		part(parent, "Fence rail", Vector3.new(width, 0.3, 0.25), origin + Vector3.new(0, y, 0), C.cream)
	end
end
local function prompt(p, screen, caption)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = caption
	pr.ObjectText = screen
	pr.HoldDuration = 0
	pr.MaxActivationDistance = 12
	pr.RequiresLineOfSight = false
	pr:SetAttribute("GardenScreen", screen)
	pr.Parent = p
end
local function building(parent, name, pos, tint, screen)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	part(m, "Foundation", Vector3.new(21, 0.6, 18), pos + Vector3.new(0, 0.3, 0), C.cream).Material =
		Enum.Material.Limestone
	part(m, "Back wall", Vector3.new(19, 9, 0.6), pos + Vector3.new(0, 5, -7), tint).Material = Enum.Material.Plaster
	for _, x in { -9, 9 } do
		part(m, "Side wall", Vector3.new(0.6, 9, 14), pos + Vector3.new(x, 5, 0), tint).Material = Enum.Material.Plaster
	end
	for _, x in { -6, 6 } do
		part(m, "Front wall", Vector3.new(6, 9, 0.6), pos + Vector3.new(x, 5, 7), tint).Material = Enum.Material.Plaster
		local glass =
			part(m, "Window", Vector3.new(3.6, 3, 0.15), pos + Vector3.new(x, 5.5, 7.35), Color3.fromRGB(155, 209, 199))
		glass.Material = Enum.Material.Glass
		glass.Transparency = 0.2
		for _, dy in { -1.6, 1.6 } do
			part(m, "Window trim", Vector3.new(4, 0.25, 0.3), pos + Vector3.new(x, 5.5 + dy, 7.45), C.cream)
		end
		part(m, "Window mullion", Vector3.new(0.2, 3.4, 0.3), pos + Vector3.new(x, 5.5, 7.45), C.cream)
	end
	for _, x in { -5, 5 } do
		local r = part(m, "Pitched roof", Vector3.new(12, 0.7, 19), pos + Vector3.new(x, 11, 0), C.roof)
		r.CFrame *= CFrame.Angles(0, 0, if x < 0 then math.rad(25) else math.rad(-25))
	end
	part(m, "Roof ridge", Vector3.new(0.7, 0.7, 19), pos + Vector3.new(0, 13.2, 0), C.roof)
	-- Exposed timber frame, lower cladding and restrained clay roof strips.
	for _, x in { -9, -3, 3, 9 } do
		part(m, "Timber frame", Vector3.new(0.25, 8.7, 0.2), pos + Vector3.new(x, 4.8, 7.4), C.wood)
	end
	for j = 1, 3 do
		for _, x in { -6, 6 } do
			part(m, "Cladding plank", Vector3.new(5.9, 0.55, 0.22), pos + Vector3.new(x, 0.8 + j * 0.55, 7.4), C.wood).Material =
				Enum.Material.WoodPlanks
		end
	end
	for _, x in { -5, 5 } do
		for j = -4, 4 do
			local slat = part(
				m,
				"Roof seam",
				Vector3.new(12, 0.12, 0.13),
				pos + Vector3.new(x, 11.4, j * 2),
				Color3.fromRGB(68, 104, 92)
			)
			slat.CFrame *= CFrame.Angles(0, 0, if x < 0 then math.rad(25) else math.rad(-25))
		end
	end
	for _, x in { -7, 7 } do
		local planter = part(m, "Window planter", Vector3.new(4, 0.9, 1.6), pos + Vector3.new(x, 3.6, 8), C.wood)
		for j = -1, 1 do
			flower(m, planter.Position + Vector3.new(j * 1.15, 0.5, 0), Color3.fromRGB(211, 155, 151))
		end
	end
	local awning = part(m, "Canvas awning", Vector3.new(7, 0.18, 3.5), pos + Vector3.new(0, 7, 8.6), C.roof)
	awning.Material = Enum.Material.Fabric
	awning.CFrame *= CFrame.Angles(0.12, 0, 0)
	for _, x in { -3.6, 3.6 } do
		part(m, "Porch post", Vector3.new(0.22, 6.8, 0.22), pos + Vector3.new(x, 3.4, 10), C.wood)
	end
	lantern(m, pos + Vector3.new(4.3, 6, 7.8))
	local sign = part(m, "Shop sign", Vector3.new(6, 1.2, 0.4), pos + Vector3.new(0, 7.8, 7.5), C.wood)
	label(sign, name)
	local counter = part(m, "Counter", Vector3.new(7, 3, 2), pos + Vector3.new(0, 1.8, 3), C.wood)
	prompt(counter, screen, "Open")
	for j = -1, 1 do
		local pot = part(
			m,
			"Display pot",
			Vector3.new(1.5, 1.4, 1.5),
			pos + Vector3.new(j * 2.5, 3.8, 3),
			Color3.fromRGB(178, 109, 78)
		)
		flower(m, pot.Position + Vector3.new(0, 0.7, 0), Color3.fromRGB(234, 181, 123))
	end
end
function World.new(catalog)
	local self = setmetatable({ catalog = catalog, plots = {}, visuals = {}, stages = {} }, World)
	local folder = Instance.new("Folder")
	folder.Name = "MutationGarden"
	folder.Parent = workspace
	self.root = folder
	local lighting = game:GetService("Lighting")
	lighting.ClockTime = 16.6
	lighting.Brightness = 2
	lighting.Ambient = Color3.fromRGB(66, 76, 91)
	lighting.OutdoorAmbient = Color3.fromRGB(127, 139, 128)
	lighting.EnvironmentDiffuseScale = 0.65
	lighting.EnvironmentSpecularScale = 0.35
	lighting.ExposureCompensation = -0.1
	lighting.ShadowSoftness = 0.4
	lighting.GlobalShadows = true
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.19
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(210, 227, 219)
	atmosphere.Decay = Color3.fromRGB(143, 162, 149)
	atmosphere.Parent = lighting
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Saturation = -0.04
	grade.Contrast = 0.07
	grade.TintColor = Color3.fromRGB(255, 247, 229)
	grade.Parent = lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.12
	bloom.Size = 18
	bloom.Threshold = 1.8
	bloom.Parent = lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.025
	rays.Spread = 0.75
	rays.Parent = lighting
	local base = part(folder, "Meadow", Vector3.new(640, 18, 640), Vector3.new(0, -10, 0), C.grass)
	base.Material = Enum.Material.Grass
	part(folder, "Plaza", Vector3.new(80, 0.35, 80), Vector3.new(0, -0.7, 0), Color3.fromRGB(194, 183, 157)).Material =
		Enum.Material.Limestone
	for i = 0, 7 do
		local a = i * math.pi / 4
		local path = part(
			folder,
			"Garden path",
			Vector3.new(10, 0.25, 110),
			Vector3.new(math.cos(a) * 85, -0.55, math.sin(a) * 85),
			Color3.fromRGB(204, 190, 159)
		)
		path.CFrame = CFrame.new(path.Position) * CFrame.Angles(0, math.pi / 2 - a, 0)
		path.Material = Enum.Material.Sandstone
	end
	-- Muted limestone pavers and seams give a readable, human-scale ground surface.
	for x = -36, 36, 6 do
		for z = -36, 36, 6 do
			local tile = part(
				folder,
				"Limestone paving",
				Vector3.new(5.85, 0.16, 5.85),
				Vector3.new(x, -0.45, z),
				Color3.fromRGB(188 + ((x + z) % 3) * 3, 183, 164)
			)
			tile.Material = Enum.Material.Limestone
		end
	end
	for _, pos in { Vector3.new(-25, 0, 22), Vector3.new(25, 0, -22) } do
		bench(folder, pos)
	end
	-- A low fountain gives the square a focal point without hiding the buildings.
	local basin =
		part(folder, "Fountain basin", Vector3.new(16, 1.2, 16), Vector3.new(0, 0, 0), C.cream, Enum.PartType.Cylinder)
	basin.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
	basin.Size = Vector3.new(1.2, 16, 16)
	local water = part(
		folder,
		"Fountain water",
		Vector3.new(0.3, 13, 13),
		Vector3.new(0, 0.7, 0),
		Color3.fromRGB(100, 180, 185),
		Enum.PartType.Cylinder
	)
	water.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
	water.Material = Enum.Material.Glass
	water.Transparency = 0.2
	water.CanCollide = false
	part(folder, "Fountain pillar", Vector3.new(2, 4, 2), Vector3.new(0, 2, 0), C.cream)
	part(
		folder,
		"Fountain bloom",
		Vector3.new(6, 1.4, 6),
		Vector3.new(0, 4.5, 0),
		Color3.fromRGB(211, 169, 179),
		Enum.PartType.Ball
	)
	local shopNames = { "Willow Seeds", "Genetics Atelier", "Research Library", "Garden Contracts", "Botanical Museum" }
	local screens = { "shop", "inventory", "research", "quests", "collection" }
	for i, name in shopNames do
		local a = (i - 1) * math.pi * 2 / 5
		building(
			folder,
			name,
			Vector3.new(math.cos(a) * 57, -0.4, math.sin(a) * 57),
			Color3.fromRGB(222 - i * 3, 214 - i * 2, 193 + i),
			screens[i]
		)
	end
	local rng = Random.new(4107)
	for j = 1, 68 do
		local a = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(192, 295)
		local pos = Vector3.new(math.cos(a) * radius, -1, math.sin(a) * radius)
		tree(folder, pos, rng:NextNumber(0.7, 1.5), rng:NextNumber(0.24, 0.36))
	end
	for j = 1, 28 do
		local a = j * 2.399
		local radius = 270 + (j % 3) * 12
		local pos = Vector3.new(math.cos(a) * radius, -1, math.sin(a) * radius)
		local mound = part(
			folder,
			"Distant meadow hill",
			Vector3.new(70, 22 + (j % 4) * 5, 65),
			pos - Vector3.new(0, 9, 0),
			Color3.fromRGB(104 + j % 3 * 5, 129, 93),
			Enum.PartType.Ball
		)
		mound.Material = Enum.Material.Grass
		rock(folder, pos + Vector3.new(12, 1, 5), Vector3.new(5, 4, 6))
	end
	for i, name in catalog.biomes do
		local a = (i - 1) * math.pi / 3
		local pos = Vector3.new(math.cos(a) * 245, -0.5, math.sin(a) * 245)
		part(folder, name, Vector3.new(44, 0.6, 44), pos, Color3.fromRGB(117 + i * 2, 137 - i * 2, 112 + i * 3)).Material =
			Enum.Material.Grass
		local sign = part(folder, "Biome sign", Vector3.new(2, 4, 1), pos + Vector3.new(0, 2, 20), C.wood)
		label(sign, name)
		for j = 1, 5 do
			local x = pos + Vector3.new((j % 3 - 1) * 11, 2, (math.floor(j / 3) - 1) * 12)
			if i == 2 then
				part(folder, "Mushroom stem", Vector3.new(1, 5, 1), x, C.cream)
				part(
					folder,
					"Mushroom cap",
					Vector3.new(7, 2, 7),
					x + Vector3.new(0, 3, 0),
					Color3.fromRGB(171, 126, 183),
					Enum.PartType.Ball
				)
			elseif i == 3 or i == 6 then
				local shard = part(folder, "Crystal", Vector3.new(2, 7 + j, 2), x, Color3.fromHSV(i / 6, 0.3, 0.85))
				shard.CFrame *= CFrame.Angles(0.2, 0, 0.2)
				shard.Material = Enum.Material.Glass
			else
				tree(folder, x - Vector3.new(0, 2, 0), 0.7, if i == 4 then 0.08 elseif i == 5 then 0.5 else 0.29)
			end
		end
	end
	for i = 1, catalog.maxPlayers do
		local a = (i - 1) * math.pi / 4
		local center = Vector3.new(math.cos(a) * 132, -0.5, math.sin(a) * 132)
		local model = Instance.new("Model")
		model.Name = "Garden" .. i
		model.Parent = folder
		part(model, "Garden lawn", Vector3.new(62, 0.4, 82), center, C.grass).Material = Enum.Material.Grass
		local path = part(
			model,
			"Garden flagstone walk",
			Vector3.new(5, 0.16, 68),
			center + Vector3.new(2, 0.32, 0),
			Color3.fromRGB(181, 178, 155)
		)
		path.Material = Enum.Material.Limestone
		for j = 1, 7 do
			local stone = part(
				model,
				"Entrance stepping stone",
				Vector3.new(3.3, 0.18, 1.8),
				center + Vector3.new((j % 2) * 0.8, 0.35, 18 + j * 2.5),
				Color3.fromRGB(194, 188, 164)
			)
			stone.CFrame *= CFrame.Angles(0, (j % 3 - 1) * 0.1, 0)
			stone.Material = Enum.Material.Limestone
		end
		bench(model, center + Vector3.new(19, 0.3, 35))
		for _, z in { -36, -24 } do
			rock(model, center + Vector3.new(26, 0.9, z), Vector3.new(2.8, 2, 3.5))
		end
		fence(model, center + Vector3.new(0, 0, -40), 60)
		fence(model, center + Vector3.new(-20, 0, 40), 20)
		fence(model, center + Vector3.new(20, 0, 40), 20)
		for _, x in { -30, 30 } do
			for z = -36, 36, 12 do
				part(model, "Hedge", Vector3.new(2.5, 2, 11), center + Vector3.new(x, 1, z), C.leaf, Enum.PartType.Ball).CanCollide =
					false
			end
			tree(model, center + Vector3.new(x * 0.8, 0, -33), 0.7, 0.3)
		end
		local marker = part(
			model,
			"Mailbox",
			Vector3.new(2.5, 1.8, 2.5),
			center + Vector3.new(-8, 3, 36),
			Color3.fromRGB(167, 106, 81)
		)
		part(model, "Mailbox post", Vector3.new(0.5, 2, 0.5), center + Vector3.new(-8, 1, 36), C.wood)
		label(marker, "Unclaimed garden")
		lantern(model, center + Vector3.new(7, 4.5, 36))
		part(model, "Garden lantern post", Vector3.new(0.25, 4, 0.25), center + Vector3.new(7, 2, 36), C.roof)
		local chest = part(model, "Storage chest", Vector3.new(5, 2.8, 3), center + Vector3.new(22, 1.6, 30), C.wood)
		prompt(chest, "inventory", "Inspect specimens")
		part(model, "Chest lid", Vector3.new(5.3, 0.5, 3.3), chest.Position + Vector3.new(0, 1.6, 0), C.cream)
		-- Glasshouse is an open frame rather than a solid transparent cube.
		local gh = center + Vector3.new(-17, 0, 29)
		for _, x in { -5, 5 } do
			for _, z in { -4, 4 } do
				part(model, "Greenhouse frame", Vector3.new(0.25, 6, 0.25), gh + Vector3.new(x, 3, z), C.cream)
			end
		end
		for _, x in { -5, 5 } do
			local glass = part(
				model,
				"Greenhouse glass",
				Vector3.new(0.15, 5.5, 8),
				gh + Vector3.new(x, 3, 0),
				Color3.fromRGB(173, 213, 203)
			)
			glass.Material = Enum.Material.Glass
			glass.Transparency = 0.75
			glass.CanCollide = false
		end
		for _, z in { -4, -2, 0, 2, 4 } do
			beam(model, gh + Vector3.new(-5, 6, z), gh + Vector3.new(0, 8, z), 0.25, C.cream)
			beam(model, gh + Vector3.new(5, 6, z), gh + Vector3.new(0, 8, z), 0.25, C.cream)
		end
		beam(model, gh + Vector3.new(0, 8, -4), gh + Vector3.new(0, 8, 4), 0.25, C.cream)
		for _, x in { -2.5, 2.5 } do
			local roof = part(
				model,
				"Greenhouse roof glass",
				Vector3.new(5.4, 0.1, 8),
				gh + Vector3.new(x, 7, 0),
				Color3.fromRGB(188, 214, 199)
			)
			roof.CFrame *= CFrame.Angles(0, 0, if x < 0 then math.rad(22) else math.rad(-22))
			roof.Material = Enum.Material.Glass
			roof.Transparency = 0.82
			roof.CanCollide = false
		end
		for _, x in { -5, 5 } do
			for _, z in { -2, 0, 2 } do
				part(model, "Glass mullion", Vector3.new(0.12, 5.5, 0.12), gh + Vector3.new(x, 3, z), C.cream)
			end
		end
		for j = 1, 12 do
			flower(
				model,
				center + Vector3.new(rng:NextNumber(-26, 26), 0.3, rng:NextNumber(-38, -33)),
				Color3.fromRGB(210 + (j % 3) * 10, 155 + (j % 4) * 12, 150 + (j % 3) * 15)
			)
		end
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Garden spawn"
		spawn.Size = Vector3.new(4, 0.2, 4)
		spawn.Position = center + Vector3.new(0, 0.6, 33)
		spawn.Anchored = true
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Enabled = false
		spawn.Parent = model
		self.plots[i] = { model = model, center = center, marker = marker, cells = {}, spawn = spawn }
	end
	-- Curated display planters provide a glimpse of the collectible plants on arrival.
	for i = 1, 6 do
		local a = i * math.pi / 3
		local pos = Vector3.new(math.cos(a) * 23, -0.2, math.sin(a) * 23)
		verticalCylinder(
			folder,
			"Terracotta display pot",
			2.2,
			1.5,
			pos + Vector3.new(0, 0.7, 0),
			Color3.fromRGB(154, 106, 81),
			Enum.Material.Brick
		)
		verticalCylinder(
			folder,
			"Pot rim",
			2.4,
			0.25,
			pos + Vector3.new(0, 1.5, 0),
			Color3.fromRGB(174, 125, 94),
			Enum.Material.Brick
		)
		self:model(
			{ id = "Display" .. i, seed = i * 771, mutations = {} },
			catalog.plants[({ 1, 7, 11, 15, 19, 25 })[i]],
			pos + Vector3.new(0, 1.7, 0),
			4,
			folder,
			{ size = 2, color = 0, light = 0 }
		)
	end
	return self
end
function World:claim(player)
	for i, p in self.plots do
		if not p.owner then
			p.owner = player
			p.model:SetAttribute("Owner", player.UserId)
			p.marker:FindFirstChildOfClass("BillboardGui").TextLabel.Text = player.DisplayName .. "'s garden"
			p.spawn.Enabled = true
			player.RespawnLocation = p.spawn
			return i
		end
	end
	return nil
end
function World:cell(plot, index)
	local block = math.floor((index - 1) / 12)
	local within = (index - 1) % 12
	return plot.center
		+ Vector3.new(
			(block % 2) * 25 - 19 + (within % 4) * 4.6,
			0.9,
			7 - math.floor(block / 2) * 15 + math.floor(within / 4) * 4.6
		)
end
function World:release(index)
	local p = self.plots[index]
	if p.owner then
		p.owner.RespawnLocation = nil
	end
	p.owner = nil
	p.spawn.Enabled = false
	p.model:SetAttribute("Owner", nil)
	p.marker:FindFirstChildOfClass("BillboardGui").TextLabel.Text = "Unclaimed garden"
	for _, c in p.cells do
		c:Destroy()
	end
	p.cells = {}
	for _, c in p.model:GetChildren() do
		if c.Name == "Bed trim" then
			c:Destroy()
		end
	end
	for id, model in self.visuals do
		if model.Parent == p.model then
			model:Destroy()
			self.visuals[id] = nil
			self.stages[id] = nil
		end
	end
end
function World:model(plant, cfg, position, stage, parent, phenotype)
	local m = Instance.new("Model")
	m.Name = plant.id
	m.Parent = parent
	local rng = Random.new(plant.seed)
	local scale = (0.3 + stage * 0.19) * (0.8 + phenotype.size * 0.15)
	local color = Color3.fromHSV((cfg.hue + phenotype.color * 0.025) % 1, 0.38, 0.84)
	for _, mutation in plant.mutations do
		if mutation == "Giant" then
			scale *= 1.8
		elseif mutation == "Miniature" then
			scale *= 0.55
		end
	end
	local function add(name, size, offset, c, shape)
		local p = part(m, name, size * scale, position + offset * scale, c, shape)
		p.CanCollide = false
		p.CanTouch = false
		if
			name == "Heart"
			and (phenotype.light >= 3 or table.find(plant.mutations, "Glowing") or table.find(plant.mutations, "Neon"))
		then
			p.Material = Enum.Material.Neon
		end
		if table.find(plant.mutations, "Golden") and (name == "Petal" or name == "Bloom") then
			p.Color = Color3.fromRGB(218, 181, 91)
			p.Material = Enum.Material.Metal
		end
		return p
	end
	local green = Color3.fromRGB(66, 123, 87)
	local arch = cfg.archetype
	if stage == 0 then
		add("Seed", Vector3.new(0.6, 0.4, 0.6), Vector3.new(0, 0.2, 0), color, Enum.PartType.Ball)
		return m
	end
	add("Stem", Vector3.new(0.35, 3, 0.35), Vector3.new(0, 1.5, 0), green)
	if arch == "Tree" then
		for j = 1, 3 do
			add(
				"Canopy",
				Vector3.new(3.6, 2.2, 3),
				Vector3.new((j - 2) * 1.1, 3 + j * 0.5, 0),
				color,
				Enum.PartType.Ball
			)
		end
	elseif arch == "Mushroom" then
		add("Cap", Vector3.new(4, 1, 4), Vector3.new(0, 3, 0), color, Enum.PartType.Ball)
	elseif arch == "Cactus" then
		add("Column", Vector3.new(1.3, 4, 1.3), Vector3.new(0, 2, 0), color)
		for j = -1, 1, 2 do
			add("Arm", Vector3.new(1, 1, 1), Vector3.new(j * 1.2, 2.2, 0), green)
			add("Finger", Vector3.new(0.6, 2, 0.6), Vector3.new(j * 1.5, 3, 0), color)
		end
	elseif arch == "Crystal" then
		for j = 1, 4 do
			local p = add("Shard", Vector3.new(0.8, 2 + j * 0.5, 0.8), Vector3.new((j - 2) * 0.6, 1.8, 0), color)
			p.CFrame *= CFrame.Angles(0, 0, (j - 2) * 0.2)
		end
	elseif arch == "Vine" then
		for j = 1, 6 do
			add(
				"Leaf",
				Vector3.new(1, 0.3, 1.6),
				Vector3.new(math.sin(j) * 1.1, j * 0.5, math.cos(j)),
				color,
				Enum.PartType.Ball
			)
		end
	elseif arch == "Bush" then
		for j = 1, 5 do
			add(
				"Foliage",
				Vector3.new(2, 1.7, 2),
				Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(1, 2.5), rng:NextNumber(-1, 1)),
				color,
				Enum.PartType.Ball
			)
		end
	elseif arch == "Aquatic" then
		add("Pad", Vector3.new(3, 0.15, 3), Vector3.new(0, 0.2, 0), green, Enum.PartType.Cylinder)
		for j = 1, 4 do
			add(
				"Bloom",
				Vector3.new(0.6, 1.4, 0.6),
				Vector3.new(math.cos(j) * 0.6, 2.5, math.sin(j) * 0.6),
				color,
				Enum.PartType.Ball
			)
		end
	elseif arch == "Exotic" then
		for j = 1, 5 do
			add(
				"Orbit",
				Vector3.new(0.8, 0.8, 0.8),
				Vector3.new(math.cos(j) * 1.4, 1 + j * 0.5, math.sin(j) * 1.4),
				color,
				Enum.PartType.Ball
			)
		end
	else
		for j = 1, 5 do
			local a = j * math.pi * 2 / 5
			add(
				"Petal",
				Vector3.new(1.5, 0.5, 1.5),
				Vector3.new(math.cos(a), 3, math.sin(a)),
				color,
				Enum.PartType.Ball
			)
		end
		add(
			"Heart",
			Vector3.new(0.9, 0.6, 0.9),
			Vector3.new(0, 3.2, 0),
			Color3.fromRGB(255, 220, 120),
			Enum.PartType.Ball
		)
	end
	return m
end
function World:render(index, profile, sim, genetics)
	local plot = self.plots[index]
	for i = 1, self.catalog.expansions[profile.expansion] do
		if not plot.cells[i] then
			local cell = part(
				plot.model,
				"Soil" .. i,
				Vector3.new(4.2, 0.5, 4.2),
				self:cell(plot, i),
				Color3.fromRGB(105, 78, 59)
			)
			cell.Material = Enum.Material.Ground
			if (i - 1) % 12 == 0 then
				local c = self:cell(plot, i) + Vector3.new(6.9, -0.15, 4.6)
				for _, x in { -9.4, 9.4 } do
					part(plot.model, "Bed trim", Vector3.new(0.3, 0.7, 14.1), c + Vector3.new(x, 0, 0), C.wood).Material =
						Enum.Material.Wood
				end
				for _, z in { -7, 7 } do
					part(plot.model, "Bed trim", Vector3.new(19, 0.7, 0.3), c + Vector3.new(0, 0, z), C.wood).Material =
						Enum.Material.Wood
				end
			end
			cell:SetAttribute("Cell", i)
			cell:SetAttribute("Owner", plot.owner.UserId)
			plot.cells[i] = cell
		end
	end
	for id, m in self.visuals do
		if m.Parent == plot.model and not profile.plants[id] then
			m:Destroy()
			self.visuals[id] = nil
			self.stages[id] = nil
		end
	end
	for id, plant in profile.plants do
		local stage = math.min(4, math.floor(plant.progress * 4))
		if self.stages[id] ~= stage then
			if self.visuals[id] then
				self.visuals[id]:Destroy()
			end
			local cfg
			for _, c in self.catalog.plants do
				if c.id == plant.species then
					cfg = c
				end
			end
			self.visuals[id] = self:model(
				plant,
				cfg,
				self:cell(plot, plant.cell) + Vector3.new(0, 0.3, 0),
				stage,
				plot.model,
				genetics.phenotype(plant.genome)
			)
			self.visuals[id]:SetAttribute("PlantId", id)
			self.visuals[id]:SetAttribute("Cell", plant.cell)
			self.visuals[id]:SetAttribute("Owner", plot.owner.UserId)
			self.stages[id] = stage
		end
	end
end
return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="13">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">30</float>
      <float name="CameraMinZoomDistance">6</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="14">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Garden</string>
        </Properties>
        <Item class="LocalScript" referent="16">
          <Properties>
            <string name="Name">Bootstrap</string>
            <string name="Source"><![CDATA[--!nocheck
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local Catalog = require(RS:WaitForChild("Shared").Catalog)
local Languages = require(RS.Shared.Localization)
local remote = RS:WaitForChild("GardenRequest")
local language = "en"
local page = "garden"
local tool = "Plant"
local profile = nil
local selectedSeed = "p01"
local parents = {}
local busy = false
local effects = true
local gui = Instance.new("ScreenGui")
gui.Name = "MutationGarden"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
local function create(class, parent, props)
	local o = Instance.new(class)
	for k, v in props do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local cream = Color3.fromRGB(244, 238, 214)
local green = Color3.fromRGB(28, 53, 47)
local accent = Color3.fromRGB(181, 197, 170)
local panel = create("Frame", gui, {
	Size = UDim2.new(0.34, 0, 0.65, 0),
	AnchorPoint = Vector2.new(1, 0),
	Visible = false,
	Position = UDim2.new(0.98, 0, 0.12, 0),
	BackgroundColor3 = green,
	BackgroundTransparency = 0.04,
})
create("UICorner", panel, { CornerRadius = UDim.new(0, 14) })
create("UIStroke", panel, { Color = Color3.fromRGB(157, 174, 149), Transparency = 0.45, Thickness = 1 })
local limit = create("UISizeConstraint", panel, { MaxSize = Vector2.new(420, 650), MinSize = Vector2.new(285, 170) })
local title = create("TextLabel", gui, {
	Position = UDim2.fromOffset(20, 8),
	Size = UDim2.new(0.7, 0, 0, 35),
	BackgroundTransparency = 1,
	Text = "MUTATION GARDEN",
	TextColor3 = cream,
	TextStrokeTransparency = 0.4,
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	TextXAlignment = Enum.TextXAlignment.Left,
})
local status = create("TextLabel", gui, {
	Position = UDim2.fromOffset(20, 43),
	Size = UDim2.new(0.86, 0, 0, 34),
	BackgroundColor3 = green,
	TextColor3 = cream,
	Font = Enum.Font.Gotham,
	TextSize = 13,
	TextWrapped = true,
	Text = Languages.en.loading,
})
local notice = create("TextLabel", panel, {
	Size = UDim2.new(1, -24, 0, 46),
	Position = UDim2.fromOffset(12, 5),
	BackgroundTransparency = 1,
	TextColor3 = accent,
	TextSize = 15,
	TextWrapped = true,
	Font = Enum.Font.Gotham,
	Text = "",
})
local tabs = create("ScrollingFrame", gui, {
	Position = UDim2.new(0.5, 0, 1, -58),
	AnchorPoint = Vector2.new(0.5, 0),
	Size = UDim2.new(0.94, 0, 0, 44),
	BackgroundTransparency = 1,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.X,
	ScrollingDirection = Enum.ScrollingDirection.X,
	ScrollBarThickness = 2,
})
create(
	"UIListLayout",
	tabs,
	{ FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }
)
create("UISizeConstraint", tabs, { MaxSize = Vector2.new(710, 44) })
create("UISizeConstraint", status, { MaxSize = Vector2.new(360, 34) })
create("UICorner", status, { CornerRadius = UDim.new(0, 10) })
local content = create("ScrollingFrame", panel, {
	Position = UDim2.fromOffset(12, 55),
	Size = UDim2.new(1, -24, 1, -68),
	BackgroundTransparency = 1,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 5,
})
local layout = create("UIListLayout", content, { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
local render, request
local function text(s)
	return create("TextLabel", content, {
		Size = UDim2.new(1, -8, 0, 48),
		BackgroundTransparency = 1,
		Text = s,
		TextColor3 = cream,
		Font = Enum.Font.Gotham,
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
end
local function button(parent, s, fn, width)
	local b = create("TextButton", parent, {
		Size = UDim2.new(if width then 0 else 1, if width then width else -8, 0, 44),
		BackgroundColor3 = accent,
		TextColor3 = green,
		Text = s,
		TextSize = 15,
		TextWrapped = true,
		Font = Enum.Font.GothamMedium,
		AutoButtonColor = true,
	})
	create("UICorner", b, { CornerRadius = UDim.new(0, 9) })
	create("UIStroke", b, { Color = Color3.fromRGB(85, 110, 87), Transparency = 0.6, Thickness = 1 })
	b.Activated:Connect(fn)
	return b
end
local function name(id)
	for _, c in Catalog.plants do
		if c.id == id then
			return c.name
		end
	end
	return id
end
request = function(action, args)
	if busy then
		return
	end
	busy = true
	local ok, result = pcall(function()
		return remote:InvokeServer(action, args or {})
	end)
	busy = false
	if not ok then
		notice.Text = "Connection interrupted. Try again."
		return
	end
	if action ~= "Sync" then
		notice.Text = result.message
	end
	if result.profile then
		if result.temporary then
			title.Text = "MUTATION GARDEN · LOCAL TEST (NO SAVES)"
		end
		profile = result.profile
		status.Text = (if result.temporary then "Test · " else "")
			.. string.format(
				"%d Coins  ·  %d RP  ·  Lv %d  ·  %s",
				profile.coins,
				profile.rp,
				1 + math.floor(profile.xp / 50),
				result.weather
			)
		render()
	end
end
local function sorted(t)
	local keys = {}
	for k in t do
		table.insert(keys, k)
	end
	table.sort(keys)
	return keys
end
render = function()
	for _, c in content:GetChildren() do
		if c ~= layout then
			c:Destroy()
		end
	end
	if not profile then
		text(Languages[language].loading)
		return
	end
	local L = Languages[language]
	if page == "garden" then
		local hints = {
			"Choose a seed, then click a soil square in the world.",
			"Water your first plant.",
			"Watch it grow, then harvest.",
			"Sell a specimen or keep two matching architectures for the lab.",
			"Cross two specimens in the lab.",
			"Experiment, research and discover all 40 species.",
		}
		text(hints[math.min(6, profile.tutorial)])
		for _, id in sorted(profile.seeds) do
			if profile.seeds[id] > 0 then
				local seed = id
				button(
					content,
					(if selectedSeed == id then "✓ " else "") .. name(id) .. " ×" .. profile.seeds[id],
					function()
						selectedSeed = seed
						tool = "Plant"
						panel.Visible = false
						render()
					end
				)
			end
		end
		text(
			"Close this panel and click a soil square in your garden. Use Water while growing, then Harvest when ready."
		)
	elseif page == "shop" then
		for _, cfg in Catalog.plants do
			local c = cfg
			button(
				content,
				string.format("%s · %s · %d coins · %ds · Lv%d", c.name, c.rarity, c.price, c.seconds, c.level),
				function()
					request("Buy", { id = c.id })
				end
			)
		end
	elseif page == "inventory" then
		text("Tap to select parents. ★ protects from sale and crossing. Sale needs a second tap.")
		button(content, L.cross .. " (" .. #parents .. "/2) · 30 Coins", function()
			if #parents == 2 then
				local a, b = parents[1], parents[2]
				parents = {}
				request("Cross", { id = a, other = b })
			else
				notice.Text = "Select two specimens first"
			end
		end)
		if next(profile.harvest) == nil then
			text("No specimens yet. Harvest your first plant.")
		end
		for _, id in sorted(profile.harvest) do
			local key = id
			local plant = profile.harvest[id]
			button(
				content,
				(if table.find(parents, id) then "✓ " else "")
					.. name(plant.species)
					.. " · "
					.. table.concat(plant.mutations, ", "),
				function()
					local i = table.find(parents, key)
					if i then
						table.remove(parents, i)
					elseif #parents < 2 then
						table.insert(parents, key)
					end
					render()
				end
			)
			button(content, (if plant.favorite then "★ " else "☆ ") .. "Protect / unprotect", function()
				request("Favorite", { id = key })
			end)
			button(content, "Replant in first free cell", function()
				local occupied = {}
				for _, v in profile.plants do
					occupied[v.cell] = true
				end
				for cell = 1, Catalog.expansions[profile.expansion] do
					if not occupied[cell] then
						request("Replant", { id = key, cell = cell })
						return
					end
				end
				notice.Text = "No free cell"
			end)
			local confirm = false
			local b
			b = button(content, L.sell, function()
				if not confirm then
					confirm = true
					b.Text = "Confirm sale"
				else
					request("Sell", { id = key })
				end
			end)
		end
	elseif page == "research" then
		text(
			"Branches: mutation odds, growth, biome unlocks, automated care and sale bonuses. Research each branch in order."
		)
		for _, cfg in Catalog.research do
			local r = cfg
			button(
				content,
				(if profile.research[r.id] then "✓ " else "")
					.. r.id
					.. " · "
					.. r.cost
					.. " RP · requires "
					.. r.requires,
				function()
					request("Research", { id = r.id })
				end
			)
		end
	elseif page == "collection" then
		for _, c in Catalog.plants do
			text(
				if profile.collection[c.id]
					then c.name .. " · " .. c.rarity .. " · " .. Catalog.biomes[c.biome]
					else "??? · " .. Catalog.biomes[c.biome]
			)
		end
	elseif page == "quests" then
		text(
			string.format(
				"Harvest contract: %d / %d. Reward: 75 Coins + 5 RP",
				profile.quest,
				(profile.questClaim + 1) * 5
			)
		)
		button(content, L.claim, function()
			request("Quest", {})
		end)
	elseif page == "settings" then
		button(content, "English / Русский", function()
			language = if language == "en" then "ru" else "en"
			render()
		end)
		button(content, "UI animations: " .. tostring(effects), function()
			effects = not effects
			render()
		end)
		button(content, L.expand .. " · " .. tostring(profile.expansion * 250) .. " Coins", function()
			request("Expand", {})
		end)
		text(
			"Walk around to visit other gardens. Only owners can manage them. Purchases and trading are not enabled in this build."
		)
	end
end
for i, key in { "garden", "shop", "inventory", "research", "collection", "quests", "settings" } do
	local k = key
	local b = button(tabs, Languages.en[key] or "Settings", function()
		local same = page == k
		page = k
		panel.Visible = not (same and panel.Visible)
		render()
		if effects then
			panel.BackgroundTransparency = 0.25
			TweenService:Create(panel, TweenInfo.new(0.15), { BackgroundTransparency = 0.04 }):Play()
		end
	end, 95)
	b.LayoutOrder = i
end
button(gui, "Menu", function()
	panel.Visible = not panel.Visible
end, 70).Position = UDim2.new(1, -90, 0, 8)
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local actionbar = create("Frame", gui, {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -68),
	Size = UDim2.fromOffset(306, 44),
	BackgroundTransparency = 1,
})
create("UIListLayout", actionbar, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) })
local toolButtons = {}
for _, mode in { "Plant", "Water", "Harvest" } do
	local m = mode
	toolButtons[m] = button(actionbar, m, function()
		tool = m
		panel.Visible = false
	end, 98)
end
local hint = create("TextLabel", gui, {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -121),
	Size = UDim2.new(0.85, 0, 0, 32),
	BackgroundTransparency = 1,
	Text = "Choose a tool, then click your garden soil",
	TextColor3 = cream,
	TextStrokeTransparency = 0.25,
	Font = Enum.Font.GothamMedium,
	TextSize = 15,
})
local highlight = Instance.new("Highlight")
highlight.FillTransparency = 0.65
highlight.OutlineColor = accent
highlight.DepthMode = Enum.HighlightDepthMode.Occluded
highlight.Parent = gui
local targetCell = nil
local function targetAt(position)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local ray = camera:ScreenPointToRay(position.X, position.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if player.Character then { player.Character } else {}
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 180, params)
	local obj = hit and hit.Instance
	while obj and obj ~= workspace do
		if obj:GetAttribute("Cell") then
			return obj
		end
		obj = obj.Parent
	end
	return nil
end
local function actAt(position)
	if not profile then
		return
	end
	local target = targetAt(position)
	if not target or target:GetAttribute("Owner") ~= player.UserId then
		return
	end
	local cell = target:GetAttribute("Cell")
	local id = nil
	for key, p in profile.plants do
		if p.cell == cell then
			id = key
			break
		end
	end
	if tool == "Plant" and not id then
		request("Plant", { id = selectedSeed, cell = cell })
	elseif id and tool ~= "Plant" then
		request(tool, { id = id })
	else
		hint.Text = if id
			then "This square is occupied. Choose Water or Harvest."
			else "Choose Plant for an empty square."
	end
end
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then
		actAt(UserInputService:GetMouseLocation())
	end
end)
UserInputService.TouchTapInWorld:Connect(function(position, processed)
	if not processed then
		actAt(position)
	end
end)
ProximityPromptService.PromptTriggered:Connect(function(pr, who)
	if who ~= player then
		return
	end
	local screen = pr:GetAttribute("GardenScreen")
	if screen then
		page = screen
		panel.Visible = true
		render()
	end
end)
local home = button(gui, "My garden", function()
	request("Home", {})
	panel.Visible = false
end, 110)
home.Position = UDim2.new(1, -130, 0, 62)
task.spawn(function()
	while gui.Parent do
		task.wait(0.12)
		for mode, b in toolButtons do
			b.BackgroundColor3 = if tool == mode then cream else accent
		end
		if not panel.Visible and not UserInputService.TouchEnabled then
			targetCell = targetAt(UserInputService:GetMouseLocation())
			highlight.Adornee = targetCell
			local own = targetCell and targetCell:GetAttribute("Owner") == player.UserId
			highlight.FillColor = if own then accent else Color3.fromRGB(210, 110, 100)
			if targetCell and own and profile then
				local plant = nil
				for _, v in profile.plants do
					if v.cell == targetCell:GetAttribute("Cell") then
						plant = v
						break
					end
				end
				hint.Text = if plant
					then string.format("%s · %d%% · %s", name(plant.species), math.floor(plant.progress * 100), tool)
					else "Plant " .. name(selectedSeed) .. " · Click soil"
			end
		else
			highlight.Adornee = nil
		end
	end
end)
request("Sync", {})
task.spawn(function()
	while gui.Parent do
		task.wait(4)
		if not busy then
			request("Sync", {})
		end
	end
end)
